# ── VDR Agent Service — Environment Variables ──────────────────────────────
# Copy this file to .env.local and fill in the values for local development.

# Deployment environment (triggers .env.local loading when set to "local")
VDR_AGENT_ENV=local

# ── Database ────────────────────────────────────────────────────────────────
VDR_AGENT_DB_HOST=localhost
VDR_AGENT_DB_PORT=5432
VDR_AGENT_DB_NAME=erm_rag
VDR_AGENT_DB_USER=erm_rag
VDR_AGENT_DB_PASSWORD=changeme

# ── AWS / Bedrock ────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=changeme

# ── Optional: AWS Secrets Manager ────────────────────────────────────────────
# VDR_AGENT_AWS_SECRET_NAME=dev/vdr-agent

# ── Logging ──────────────────────────────────────────────────────────────────
VDR_AGENT_LOG_LEVEL=INFO

# ── CORS ─────────────────────────────────────────────────────────────────────
# VDR_AGENT_CORS_ORIGINS=["*"]
